# ==================== Конфигурация пользовательских коммитов ====================
# Этот файл задаёт фиксацию конкретных коммитов SUSFS и SukiSU.
#
# Как пользоваться:
#   1. Установите custom=true, чтобы включить фиксацию коммитов.
#   2. Впишите нужный commit hash в соответствующую строку.
#   3. Пустое значение = использовать последний коммит ветки.
#
# Пример:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================================

# Включить фиксацию коммитов (true/false)
# false = всегда собирать последний коммит ветки susfs4ksu (рекомендуется).
# Пины используются только при custom=true.
custom=false

# ==================== Commit hash для веток SUSFS ====================
# Используется только при custom=true. Пустое значение = последний коммит ветки.
# Ветки SUSFS перебазируются независимо, поэтому хеш из одной линейки ядер
# не существует в другой.
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== Commit hash для SukiSU ====================
# Используется только при custom=true и только для варианта SukiSU.
sukisu=
